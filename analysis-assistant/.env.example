# Port for the Express API (the Angular dev server proxies /api here)
PORT=3001

# Gemini API key from Google AI Studio. Keep this server-side only.
GEMINI_API_KEY=

# Gemini model available to your API key and compatible with chat completions
GEMINI_MODEL=gemini-3.8-flash

# OpenAI-compatible Gemini endpoint
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
